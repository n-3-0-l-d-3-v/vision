__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# Vision's vault MOC notes are per-project records generated by `vision new`
# on this machine -- some are private-tier by design (--private routes to
# vault/Vision/private/). Committing them by default would defeat the point
# of the private/work split, so the whole vault/Vision/ tree is gitignored,
# matching Wall-E's "don't commit generated-on-this-machine notes by
# default" call for its own vault/Wall-E/ (see wall-e/README.md "vault/ and
# git"). .gitkeep files keep the directory skeleton itself tracked so
# vault/Vision/ and vault/Vision/private/ exist after a fresh clone.
vault/Vision/*
!vault/Vision/.gitkeep
!vault/Vision/private/
vault/Vision/private/*
!vault/Vision/private/.gitkeep
